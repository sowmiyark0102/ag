# Secret used to sign JWTs - replace with a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the Express API listens on
PORT=5000

# Origin allowed to call this API (your deployed frontend URL in production)
CLIENT_ORIGIN=http://localhost:5173

# Base URL of the ML/FastAPI service (optional - the backend has its own decision engines)
ML_SERVICE_URL=http://localhost:8000

# Optional: live weather API key (leave blank to stay in DEMONSTRATION DATA mode)
WEATHER_API_KEY=

# NOTE: No database is required. AgriCast AI runs on an in-memory data store
# that seeds demo data automatically on server start. Data resets whenever
# the backend process restarts - that's expected for this prototype.
